# =============================================================================
# ZELQANE — Environment Variables
# Copy this file to .env and replace every <placeholder> before running docker-compose.
#
# SECURITY: this file contains placeholders only. The JWT secret that used to be committed here
# (and in start-local.ps1) is still in the git history and must be considered COMPROMISED: the
# backend refuses to start with it. Every deployment must generate its own secrets, e.g.
#   PowerShell : -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#   bash       : openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Database name created on first container start
POSTGRES_DB=zelqane

# PostgreSQL superuser credentials (used by docker-compose postgres service)
POSTGRES_USER=zelqane_user

# PostgreSQL password — use a strong value
POSTGRES_PASSWORD=<mot de passe PostgreSQL>

# Host port exposed on the host machine for local development
POSTGRES_PORT=5432

# JDBC host — use "localhost" when running Spring Boot on the host;
# use "postgres" when the backend runs inside the same Docker network
DB_HOST=localhost

# JDBC port — matches POSTGRES_PORT in most setups
DB_PORT=5432

# -----------------------------------------------------------------------------
# pgAdmin 4
# -----------------------------------------------------------------------------
# Login email for the pgAdmin web UI (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com

# Login password for the pgAdmin web UI
PGADMIN_DEFAULT_PASSWORD=<mot de passe pgAdmin>

# Host port for pgAdmin web interface
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Spring Boot Application
# -----------------------------------------------------------------------------
# Active Spring profile: dev | local | docker (docker-compose forces docker)
# "local" enables the simulated player time (?datetime=) for demos only.
SPRING_PROFILES_ACTIVE=dev

# HTTP port the backend listens on
SERVER_PORT=8080

# Application display name (logging, actuator)
SPRING_APPLICATION_NAME=zelqane-backend

# -----------------------------------------------------------------------------
# Datasource (Spring Boot)
# -----------------------------------------------------------------------------
# Full JDBC URL — override individual parts below if preferred
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zelqane

# Datasource username — should match POSTGRES_USER
SPRING_DATASOURCE_USERNAME=zelqane_user

# Datasource password — should match POSTGRES_PASSWORD
SPRING_DATASOURCE_PASSWORD=<mot de passe PostgreSQL>

# Connection pool size (HikariCP)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# -----------------------------------------------------------------------------
# JPA / Hibernate
# -----------------------------------------------------------------------------
# SQL logging — set to true only during local debugging
SPRING_JPA_SHOW_SQL=false

# -----------------------------------------------------------------------------
# Flyway
# -----------------------------------------------------------------------------
FLYWAY_SCHEMA=public

# -----------------------------------------------------------------------------
# Secrets (docs/round2-contract.md §3.1) — REQUIRED
# -----------------------------------------------------------------------------
# JWT signing secret: at least 32 bytes. No default: the backend fails fast without it.
JWT_SECRET=<générez 64 caractères hexadécimaux>

# Access token validity in milliseconds (default: 24 hours)
JWT_EXPIRATION_MS=86400000

# Refresh token validity in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# HMAC key of signed media URLs (recommended). Empty → derived from JWT_SECRET
# (rotating JWT_SECRET then simply invalidates media links).
MEDIA_SIGNING_SECRET=<générez 64 caractères hexadécimaux>

# Lifetime of a signed media URL, in seconds
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# AES key of stored TOTP secrets (recommended). Empty → derived from JWT_SECRET, and rotating
# JWT_SECRET would then force every user to enrol their authenticator app again.
TOTP_ENCRYPTION_KEY=<générez 64 caractères hexadécimaux>

# -----------------------------------------------------------------------------
# Accounts: bootstrap administrator and two-factor authentication
# -----------------------------------------------------------------------------
# Created at first start only when no active administrator exists.
ZELQANE_ADMIN_EMAIL=admin@zelqane.local
# 8 to 100 characters, at least one letter and one digit.
# Empty → a random password is generated and printed ONCE in the backend log.
ZELQANE_ADMIN_INITIAL_PASSWORD=
# The bootstrap administrator must choose a new password at first login.
ZELQANE_ADMIN_MUST_CHANGE_PASSWORD=true

# Issuer shown in authenticator apps
ZELQANE_TOTP_ISSUER=ZELQANE
# Roles that must use 2FA (comma list among ADMINISTRATEUR, SUPERVISEUR, OPERATEUR; empty = optional).
# Recommended in production:
ZELQANE_TOTP_REQUIRED_ROLES=ADMINISTRATEUR,SUPERVISEUR,OPERATEUR

# -----------------------------------------------------------------------------
# Player screens (§3.4)
# -----------------------------------------------------------------------------
# ?datetime= of /api/diffusion/next is honoured only when true (demo). Keep false in production.
ZELQANE_SIMULATED_TIME_ENABLED=false

# -----------------------------------------------------------------------------
# Media Upload Storage
# -----------------------------------------------------------------------------
# Absolute or relative path where campaign media files are stored
MEDIA_UPLOAD_DIR=./uploads

# Base URL prefix of media links (served only with a valid signature: /uploads/...?exp=&sig=)
MEDIA_BASE_URL=/uploads

# Upload limits: images/banners and videos (bytes), media files per campaign
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=52428800
MEDIA_MAX_FILES_PER_CAMPAIGN=5

# -----------------------------------------------------------------------------
# AI analysis (§2.1): OCR, local image analysis, optional LLM moderation
# -----------------------------------------------------------------------------
# OCR engine: auto (Tesseract/Tess4J when tessdata is present, else simulated) | tess4j | simulated
ZELQANE_OCR_MODE=auto
# Folder of *.traineddata (fetched by BackEnd/scripts/fetch-tessdata.ps1 or .sh; /app/tessdata in Docker)
ZELQANE_OCR_TESSDATA=./tessdata
ZELQANE_OCR_LANGUAGES=fra+eng+ara

# Vision moderation provider: local | openai | anthropic (the local analysis always runs)
ZELQANE_AI_PROVIDER=local
ZELQANE_AI_PROVIDER_TIMEOUT_MS=90000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Learning from administrator decisions (nightly recalibration)
ZELQANE_AI_LEARNING_ENABLED=true
ZELQANE_AI_LEARNING_AUTO_APPLY=true

# -----------------------------------------------------------------------------
# Dynamic pricing (§4.1)
# -----------------------------------------------------------------------------
ZELQANE_DYNAMIC_PRICING_ENABLED=true

# -----------------------------------------------------------------------------
# Supervision, approvals and notifications (§5.1)
# -----------------------------------------------------------------------------
# Distinct administrators required before an emergency is broadcast (1 disables)
ZELQANE_EMERGENCY_APPROVALS=2
# Distinct administrators required for an AI override or a risky campaign (1 disables)
ZELQANE_CAMPAIGN_APPROVALS=2
ZELQANE_CAMPAIGN_APPROVAL_RISK=50

# Optional e-mail notifications: enabled only when SPRING_MAIL_HOST and ZELQANE_MAIL_FROM are set
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
ZELQANE_MAIL_FROM=
# Public URL of the frontend used in e-mail links
ZELQANE_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# CORS (Next.js frontend on 3000; 4200 kept for the legacy Angular client)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# -----------------------------------------------------------------------------
# Business rules (all optional; defaults shown)
# -----------------------------------------------------------------------------
# Time zone for "now", campaign dates, schedulers and diffusion datetimes
ZELQANE_TIMEZONE=Africa/Tunis
# Lifecycle, reservation expiry, emergency auto-stop and statistics snapshot schedulers
ZELQANE_SCHEDULER_ENABLED=true
# A TEMPORAIRE reservation of an unsubmitted campaign expires after this many hours
ZELQANE_RESERVATION_TTL_HOURS=72
# Diffusion engine: max broadcasts of one campaign per Porteur per rolling hour, default slot length (s)
ZELQANE_DIFFUSION_MAX_PER_HOUR=30
ZELQANE_DIFFUSION_DEFAULT_DURATION=10
# Content played when nothing is scheduled (empty media URL = none)
ZELQANE_DIFFUSION_DEFAULT_TITLE=ZELQANE — Tukhnanutha
ZELQANE_DIFFUSION_DEFAULT_CONTENT=Espace de diffusion ZELQANE
ZELQANE_DIFFUSION_DEFAULT_MEDIA_URL=
# Minimum interval (seconds) between two lastSeenAt updates of a session
ZELQANE_SESSION_TOUCH_SECONDS=60

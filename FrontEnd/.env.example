# Spring backend base URL (server-side only, read by the /api bridge)
TPUB_API_URL=http://localhost:8080
# Optional: forward contact form submissions as JSON to this webhook
CONTACT_WEBHOOK_URL=
# Optional: public site URL used for metadata (OpenGraph, sitemap)
SITE_URL=http://localhost:3000
# Optional (build time): CARTO basemap key for the network map. Without it the map uses the
# keyless Esri Canvas grey basemaps (CARTO tiles now show an « API KEY REQUIRED » watermark).
NEXT_PUBLIC_CARTO_API_KEY=
